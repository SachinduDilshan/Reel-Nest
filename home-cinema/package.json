{
  "name": "ReelNest",
  "version": "1.0.0",
  "description": "Your personal home cinema. Browse and watch the movies and series on your laptop, fully offline.",
  "author": "Sachindu Dilshan Abeyrathne",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "local.reelnest",
    "productName": "ReelNest",
    "compression": "maximum",
    "electronLanguages": [
      "en-US"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**"
    ],
    "files": [
      "**/*",
      "!dist/**",
      "!**/*.md",
      "!**/*.map"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    }
  },
  "dependencies": {
    "chokidar": "^3.6.0",
    "ffmpeg-static": "^5.3.0"
  }
}